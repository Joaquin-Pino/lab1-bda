# BASE DE DATOS Y CONEXIÓN
# Se usan las mismas variables para crear la BD en Docker y para que el Backend se conecte
DB_NAME=festivales
DB_USER=festivales_user
DB_PASSWORD=festivales_pass
DB_PORT=5432
DB_POOL_SIZE=10

# Host de la BD: 
# Usa 'localhost' si ejecutas el backend desde tu editor de código.
# Usa 'postgres' (el nombre del servicio en docker-compose) si levantas TODO con Docker.
DB_HOST=postgres

# BACKEND (Spring Boot)
BACKEND_PORT=8080
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRATION_MINUTES=120
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# FRONTEND (React / Vite)
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080